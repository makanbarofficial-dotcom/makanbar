# تنظیمات هاست Apache (cPanel / DirectAdmin) برای نسخه‌ی ثابت سایت

DirectoryIndex index.html
AddType application/manifest+json .webmanifest
AddType application/vnd.android.package-archive .apk
ErrorDocument 404 /404.html

# همه آدرس‌های http به https امن منتقل می‌شوند (گواهی SSL هاست فعال است)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# فایل تأیید اپ اندروید (Digital Asset Links)؛ کافه‌بازار آن را کنار آدرس شروع اپ (/app/) هم می‌خواهد
RewriteRule ^(.+/)?\.well-known/assetlinks\.json$ /.well-known/assetlinks.json [L]

<IfModule mod_headers.c>
  # فایل‌های _next/static نام یکتا دارند و برای همیشه کش می‌شوند
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # صفحه‌ها همیشه از نو بررسی می‌شوند تا تغییرات فوری دیده شوند
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
